<?xml version="1.0" encoding="utf-8"?>
<!-- The library is a SAF grant and playlists live in a local Room database; neither is
     meaningful on another device, and the folder grant cannot be transferred anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
